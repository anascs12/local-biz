# SPEC §21.5 — server-only secrets. Never prefix a credential with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# AI provider auth (server only)
ANTHROPIC_API_KEY=your_key_here

# Model identifier (server only)
AI_MODEL=claude-sonnet-4-6

# Canonical URL for metadata (public)
NEXT_PUBLIC_APP_URL=http://localhost:3000
